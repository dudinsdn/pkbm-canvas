#!/usr/bin/env python3
"""Emit migration/seed SQL for PostgreSQL; no database connection here."""
from pathlib import Path
import sys,json
root=Path(__file__).resolve().parents[1]
action=sys.argv[1]
if action=='migrate':
 print("BEGIN;\nSELECT pg_advisory_xact_lock(73131007);\nCREATE TABLE IF NOT EXISTS schema_migrations(version varchar PRIMARY KEY);")
 print("SELECT NOT EXISTS (SELECT 1 FROM schema_migrations WHERE version='20261007000100') AS apply_migration \\gset")
 print('\\if :apply_migration')
 print((root/'apps/pkbm/db/catalog.sql').read_text())
 print("INSERT INTO schema_migrations(version) VALUES ('20261007000100');\n\\endif\nCOMMIT;")
elif action=='seed':
 data=json.loads((root/'apps/pkbm/db/seeds/catalog.json').read_text())
 def lit(v):
  if v is None:return 'NULL'
  if isinstance(v,bool):return 'true' if v else 'false'
  if isinstance(v,(int,float)):return str(v)
  if isinstance(v,(dict,list)):v=json.dumps(v,ensure_ascii=False)
  return "'"+str(v).replace("'","''")+"'"
 print('BEGIN;\nSELECT pg_advisory_xact_lock(73131007);')
 for table,rows in data['tables'].items():
  for row in rows:
   cols=', '.join('"'+c+'"' for c in row)
   print(f'INSERT INTO "{table}" ({cols}) VALUES ({", ".join(lit(v) for v in row.values())}) ON CONFLICT(id) DO NOTHING;')
   expected=lit(json.dumps(row,ensure_ascii=False))
   key=lit(table+'/'+row['catalog_key'])
   print(f"DO $seed_guard$ BEGIN IF NOT EXISTS (SELECT 1 FROM \"{table}\" t WHERE id={lit(row['id'])} AND to_jsonb(t) @> {expected}::jsonb) THEN RAISE EXCEPTION 'Seed content changed: %', {key}; END IF; END; $seed_guard$;")
 print('COMMIT;')
else:raise SystemExit('Use migrate or seed')
